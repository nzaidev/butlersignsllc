# Copy to .env.local and add your OpenAI API key
OPENAI_API_KEY=sk-...

# Content editor (/admin). See docs/CMS.md.
# Accounts as name:password pairs, comma-separated. Passwords: 12+ characters, no commas.
CMS_USERS=owner:change-me-to-a-long-password,seo:change-me-to-another-long-password
# Signs login sessions. Generate with: openssl rand -base64 32
CMS_SESSION_SECRET=
# Set automatically on Vercel when a Blob store is connected to the project.
# BLOB_READ_WRITE_TOKEN=
